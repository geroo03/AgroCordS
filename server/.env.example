# Backend de "Ventana de Aplicación" — lotes, aplicaciones, plan premium,
# uso del chat y notificaciones. Reemplaza a localStorage cuando el usuario
# está autenticado (ver src/lib/almacen.ts en la raíz del repo).
#
# Puerto local. En Railway (u otro host) suele venir provisto por la
# plataforma; dejalo igual acá para correrlo en tu máquina.
PORT=4000

# Proyecto de Supabase. Se completan cuando exista un proyecto real — hasta
# entonces el servidor arranca pero rechaza con un error claro cualquier
# request (fail-fast, nunca un 500 sin explicación).
SUPABASE_URL=
# ATENCIÓN: la service role key bypasea Row Level Security por completo.
# Sólo la lee este servidor — nunca debe llegar al navegador ni a una
# variable NEXT_PUBLIC_*. Este backend filtra manualmente por user_id en
# cada consulta; RLS queda como respaldo, no como mecanismo principal.
SUPABASE_SERVICE_ROLE_KEY=

# Origen permitido para CORS: la URL del frontend Next.js.
# En desarrollo local, next dev sirve en el puerto 3000.
CORS_ORIGIN=http://localhost:3000
