# Sentinel Hub / Copernicus Data Space Ecosystem (datos NDVI/NDRE reales).
# Sin estas dos variables la app usa datos de demostración, marcados como tales.
# Sólo las lee el servidor (API routes); nunca llegan al navegador.
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Opcionales. Por defecto apuntan a Copernicus Data Space Ecosystem.
# Descomentar sólo para una cuenta de Sentinel Hub clásica u otro despliegue.
# SENTINELHUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# SENTINELHUB_STATS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics

# Pagos onchain con stablecoins de Twin Finance (ARGt, BRAt) sobre Base.
# A diferencia de las de arriba, estas variables SÍ son NEXT_PUBLIC_*: una
# dirección de contrato o de wallet de destino es información pública (se ve
# en BaseScan), no un secreto, y el navegador la necesita para armar la
# transacción que la wallet del usuario firma. Nunca se guarda ni se pide una
# clave privada en esta app. Sin NEXT_PUBLIC_PAGOS_DESTINO y al menos un
# contrato de token, la sección de pago onchain no se muestra: el paywall
# sigue funcionando sólo con "Activar Premium (demo)".
#
# "base" (mainnet, dinero real) o "base-sepolia" (testnet, recomendado para probar).
NEXT_PUBLIC_PAGOS_RED=base-sepolia
# Wallet de la demo que recibe el pago.
NEXT_PUBLIC_PAGOS_DESTINO=
# Direcciones de contrato en la red elegida arriba. Conseguirlas desde la
# documentación oficial de Twin Finance (twin.finance/contact o su Discord) o
# del material del track del hackathon — nunca inventarlas ni copiarlas de un
# resultado de búsqueda sin verificar en BaseScan.
NEXT_PUBLIC_ARGT_CONTRATO=
NEXT_PUBLIC_BRAT_CONTRATO=
# Monto de demostración por token (no un precio de producción calibrado).
# NEXT_PUBLIC_PAGOS_MONTO_DEMO=1
# RPC propio; por defecto usa el RPC público de Base para la red elegida.
# PAGOS_RPC_URL=
