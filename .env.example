# Sentinel Hub / Copernicus Data Space Ecosystem (datos NDVI/NDRE reales).
# Sin estas dos variables la app usa datos de demostración, marcados como tales.
# Sólo las lee el servidor (API routes); nunca llegan al navegador.
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# Opcionales. Por defecto apuntan a Copernicus Data Space Ecosystem.
# Descomentar sólo para una cuenta de Sentinel Hub clásica u otro despliegue.
# SENTINELHUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# SENTINELHUB_STATS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics
